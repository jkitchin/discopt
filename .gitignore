# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Rust
/target/

# Caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Archive
/archive/

# Environments
.env
.venv/

# Coverage artifacts
.coverage
coverage.xml
coverage.svg

# Scratch / reference materials
/ref/

# Benchmark results and reports
/results/
/reports/
/discopt_benchmarks/reports/

# Generated course material (built from python/discopt/course/)
/course/

# Build output
_build/

# Task files
tasks.org

# LaTeX build artifacts
manuscript/_minted/
manuscript/*.aux
manuscript/*.bbl
manuscript/*.bcf
manuscript/*.blg
manuscript/*.dvi
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.run.xml
manuscript/*.synctex.gz
manuscript/*.toc
# discopt.tex is generated from discopt.org via `scimax export discopt.org --format pdf`
manuscript/discopt.tex

# Claude Code
.claude/

# Crucible knowledge base: track the wiki and bib, exclude generated /
# copyrighted / transient artifacts.
.crucible/crucible.db
.crucible/references.bib.lock
.crucible/sources/external/
.crucible/wiki/viz.html

# Adversary test runs
adversary/

# Jupyter Book
docs/_build/

# DoE demo workbook artifacts
docs/notebooks/*.xlsx

# Solver-written .sol files (POUNCE / AMPL solvers like couenne/scip write a
# <stub>.sol next to the input .nl when run over the vendored instance tree).
# These are run artifacts, never fixtures (0 are tracked) — keep them out.
*.sol

# stray solver listing files (GAMS/BARON .lst) — not part of the repo
*.lst

# scratchpad run logs (keep the harnesses, drop the outputs)
scratchpad/*_out*.txt
scratchpad/*.log
scratchpad/**/*_out*.txt
scratchpad/**/*.log
scratchpad/**/*.out
# per-cell worker scripts a probe WRITES at run time (same rule: keep the
# harness, drop what it generates). The leading underscore is the convention —
# a hand-written harness like ``issue966_neutral_worker.py`` has none and stays
# tracked; ``_issue966_yield_fix_worker.py`` is re-emitted on every run.
scratchpad/_*_worker.py

# LLVM/Rust coverage artifacts — `cargo test` with instrumentation drops these
# in the working dir. Six of them (~10 MB) were committed by accident in #904.
*.profraw

# Benchmark-panel outputs written to the repo root. Same rule as the scratchpad
# block above: keep the harness (`discopt_benchmarks/scripts/*.py`), drop what it
# generates. `issue844_primal_quality_panel.py` defaults `--out` to a bare
# filename, so a run from the repo root leaves one here.
/*_quality_panel.json
