"""#1039 bucket E: can the row-filter byte-identical test be made a valid comparison?

``test_failure_triggered_is_byte_identical_on_solving_instances`` compares an
ON arm against an OFF arm under ``time_limit=20``. For an instance that does not
finish in 20 s the two arms are truncated at *different points in the search*, so
any difference measures the stopwatch, not the flag. Measured earlier: casctanks
drifts within a single arm (nodes 3/5/3); bchoco07 differs reproducibly by arm
with the ON arm overrunning by ~1.5 s.

#1116 already established the mechanism for a valid comparison -- and established
that ``max_nodes`` ALONE is not it ("a deterministic max_nodes budget makes solves
bit-reproducible" is RETRACTED in solver.py:944). What buys reproducibility is
``deterministic=True``, and only under its stated precondition: the solve must
terminate on WORK with real slack against ``time_limit``.

This probe tests that precondition instance by instance: 2 repetitions per arm,
per instance, interleaved. No exception swallowed (§7); executed-comparison count
printed, non-zero exit at zero (§6).
"""

import os
import sys

os.environ.setdefault("JAX_PLATFORMS", "cpu")
os.environ.setdefault("JAX_ENABLE_X64", "1")

import discopt.modeling.core as dm

assert "/Users/jkitchin/projects/discopt/python/discopt" in dm.__file__, dm.__file__

FLAG = "DISCOPT_RELAX_ROW_FILTER"
DATA = "python/tests/data/minlplib_nl"
NAMES = ["alan", "ex1221", "nvs09", "bchoco07", "beuster", "casctanks"]
MAX_NODES = 25
TL = 120.0

checks = 0
for name in NAMES:
    path = os.path.join(DATA, f"{name}.nl")
    if not os.path.exists(path):
        print(f"{name}: not vendored", flush=True)
        continue
    runs = {}
    for rep in range(3):
        for arm in ("0", "1"):
            os.environ[FLAG] = arm
            r = dm.from_nl(path).solve(
                time_limit=TL, max_nodes=MAX_NODES, deterministic=True
            )
            runs.setdefault(arm, []).append(
                (r.status, r.objective, r.bound, r.node_count, r.wall_time)
            )
            checks += 1
    off, on = runs["0"], runs["1"]
    self_off = off[0][:4] == off[1][:4]
    self_on = on[0][:4] == on[1][:4]
    cross = off[0][:4] == on[0][:4]
    bound_binds = any(x[0] == "time_limit" for x in off + on)
    print(
        f"{name:11s} tl_bound={bound_binds} self_off={self_off} self_on={self_on} "
        f"cross={cross}",
        flush=True,
    )
    for arm, rs in (("OFF", off), ("ON ", on)):
        for r in rs:
            print(
                f"    {arm} status={r[0]:10s} nodes={r[3]:4d} obj={r[1]} "
                f"bound={r[2]} wall={r[4]:.1f}",
                flush=True,
            )

print(f"\nEXECUTED SOLVES: {checks}")
if checks == 0:
    sys.exit(1)
