+    parse_search_global_pool(raw.as_deref()).unwrap_or_else(|e| panic!("{e}"))
+}
+
+/// The parse table behind [`search_global_pool_enabled`]; garbage is refused, not
+/// defaulted.
+fn parse_search_global_pool(raw: Option<&str>) -> Result<bool, String> {
+    let Some(v) = raw else { return Ok(false) };
+    match v.trim().to_ascii_lowercase().as_str() {
+        "1" | "true" | "yes" | "on" => Ok(true),
+        "0" | "false" | "no" | "off" | "" => Ok(false),
+        other => Err(format!(
+            "DISCOPT_HIGHS_SEARCH_GLOBAL_POOL={other:?} is not recognized (expected 1 or 0)"
+        )),
+    }
+}
