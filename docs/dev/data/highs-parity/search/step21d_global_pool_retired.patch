+/// A ported-pool cut `vals·x[inds] <= rhs` as `coeffs·x >= -rhs` over `n` columns.
+fn pool_cut_ge(n: usize, inds: &[i32], vals: &[f64], rhs: f64) -> GomoryCut {
+    let mut coeffs = vec![0.0; n];
+    for (&j, &v) in inds.iter().zip(vals) {
+        coeffs[j as usize] = -v;
+    }
+    GomoryCut { coeffs, rhs: -rhs }
+}
