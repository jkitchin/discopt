+// discopt dump (HS_DUMP_QUEUE): every queue operation, then the queue's state, so the
+// port of HighsNodeQueue can be replayed against it. Queues are tagged by first use.
+static FILE* hsQueueDump() {
+  static FILE* f = nullptr;
+  static bool init = false;
+  if (!init) {
+    init = true;
+    if (const char* p = std::getenv("HS_DUMP_SEARCH")) f = std::fopen(p, "w");
+    else if (const char* p2 = std::getenv("HS_DUMP_QUEUE")) f = std::fopen(p2, "w");
+  }
+  return f;
+}
+// The search dump writes to the same file, so queue and search events interleave in
+// the order they happen.
+FILE* hsSearchDumpFile() { return std::getenv("HS_DUMP_SEARCH") ? hsQueueDump() : nullptr; }
+static int hsQueueTag(const void* q) {
+  static std::map<const void*, int> tags;
+  auto it = tags.find(q);
+  if (it != tags.end()) return it->second;
+  int t = (int)tags.size();
+  tags[q] = t;
+  return t;
+}
