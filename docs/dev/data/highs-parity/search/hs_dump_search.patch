+// ---- discopt dump (HS_DUMP_SEARCH): wrappers recording each control call ----
+void HighsSearch::hsDumpLine(const char* tag, int result, bool withNode) {
+  FILE* f = hsSearchDump(mipsolver, inheuristic);
+  if (!f) return;
+  if (withNode && !nodestack.empty()) {
+    const NodeData& n = nodestack.back();
+    std::fprintf(f, "%s %d %d %a %a %a %d %d %a %a %d %a %a\n", tag, result,
+                 (int)getCurrentDepth(), n.lower_bound, n.estimate, n.lp_objective,
+                 (int)n.opensubtrees, (int)n.branchingdecision.column,
+                 n.branchingdecision.boundval, n.branching_point,
+                 n.branchingdecision.boundtype == HighsBoundType::kLower ? 0 : 1,
+                 getCutoffBound(), getOptimalityLimit());
+  } else {
+    std::fprintf(f, "%s %d %d\n", tag, result, (int)getCurrentDepth());
+  }
+}
+
+HighsSearch::NodeResult HighsSearch::evaluateNode() {
+  NodeResult r = evaluateNodeImpl();
+  hsDumpLine("SE", (int)r, true);
+  if (FILE* f = hsSearchDump(mipsolver, inheuristic)) {
+    std::fprintf(f, "SEF %d", (int)lp->getFractionalIntegers().size());
+    for (const auto& fr : lp->getFractionalIntegers())
+      std::fprintf(f, " %d %a", (int)fr.first, fr.second);
+    std::fprintf(f, "\n");
+  }
+  return r;
+}
+
+HighsSearch::NodeResult HighsSearch::branch() {
+  double hsLb0 = nodestack.empty() ? -kHighsInf : nodestack.back().lower_bound;
+  NodeResult r = branchImpl();
+  hsDumpLine("SB", (int)r, true);
+  if (FILE* f = hsSearchDump(mipsolver, inheuristic)) {
+    if (r == NodeResult::kBranched && nodestack.size() >= 2) {
+      const NodeData& p = nodestack[nodestack.size() - 2];
+      std::fprintf(f, "SBP %d %d %a %a %a %a %a %d %a\n", (int)p.branchingdecision.column,
+                   p.branchingdecision.boundtype == HighsBoundType::kLower ? 0 : 1,
+                   p.branchingdecision.boundval, p.branching_point, p.other_child_lb,
+                   p.lower_bound, p.estimate, (int)p.opensubtrees, hsLb0);
+    }
+  }
+  return r;
+}
+
+bool HighsSearch::backtrack(bool recoverBasis) {
+  bool r = backtrackImpl(recoverBasis);
+  hsDumpLine("SK", (int)r, true);
+  return r;
+}
+
+bool HighsSearch::backtrackPlunge(HighsNodeQueue& nodequeue) {
+  bool r = backtrackPlungeImpl(nodequeue);
+  hsDumpLine("SP", (int)r, true);
+  return r;
+}
+
+HighsSearch::NodeResult HighsSearch::dive(int64_t nodeLim) {
+  hsDumpLine("SD0", 0, false);
+  NodeResult r = diveImpl(nodeLim);
+  hsDumpLine("SD", (int)r, true);
+  return r;
+}
