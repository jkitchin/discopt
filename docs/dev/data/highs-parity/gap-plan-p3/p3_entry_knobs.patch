+            return bj.cmp(&bi);
+        }
+        let (ca, cb) = (solval[i] * vals[i], solval[j] * vals[j]);
+        if ca > cb + feastol {
+            return std::cmp::Ordering::Less;
+        }
+        if ca < cb - feastol {
