+def _milp_root_cmir_enabled() -> bool:
+    """``DISCOPT_MILP_ROOT_CMIR`` (gap plan P3, default OFF): run the aggregated c-MIR /
+    lifted-cover separator (``lp/cmir.rs``) in the pure-MILP route's root cut loop.
+
+    The route's root loop separates GMI and covers only; HiGHS closes the fixed-charge
+    rows' root gap with path aggregation + c-MIR (`HighsPathSeparator`,
+    `HighsCutGeneration`) without presolve (gap plan §1.1, Table 3). Bound-changing,
+    so default OFF until its §5 panel; every cut is a nonnegative combination of model
+    rows rounded over global bounds (the ``cmir.rs`` soundness argument).
+    """
+    raw = os.environ.get("DISCOPT_MILP_ROOT_CMIR")
+    if raw is None:
+        return False
+    val = raw.strip().lower()
+    if val in ("1", "true", "yes"):
+        return True
+    if val in ("0", "false", "no", ""):
+        return False
+    raise ValueError(f"DISCOPT_MILP_ROOT_CMIR={raw!r} is not recognized (expected 1 or 0)")
+
