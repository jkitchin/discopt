+                has_neg |= w < 0.0;
+                vals.push(w);
+                upper.push(INF);
+                is_int.push(false);
+            }
+            let cap: f64 = (0..ni).map(|i| vals[i] * upper[i]).sum();
+            let b = (0.2 + 0.6 * r.next()) * cap;
