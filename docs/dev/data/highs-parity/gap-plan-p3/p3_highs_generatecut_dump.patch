 #include "mip/HighsTransformedLp.h"
 #include "util/HighsIntegers.h"
 
+#include <cstdio>
+#include <cstdlib>
+// ---- generateCut replay dump (HS_DUMP_GC=<path>) ----
+static long gcDumpCounter = 0;
+static FILE* gcDumpFile(const HighsMipSolver& mip) {
+  static FILE* f = nullptr;
+  static bool init = false;
+  static long maxc = 0;
+  if (mip.submip) return nullptr;
+  if (!init) {
+    init = true;
+    const char* p = std::getenv("HS_DUMP_GC");
+    if (p) f = std::fopen(p, "w");
+    const char* m = std::getenv("HS_DUMP_GC_MAX");
+    maxc = m ? std::atol(m) : 4000;
+  }
+  if (!f) return nullptr;
+  if (gcDumpCounter >= maxc) { std::fflush(f); return nullptr; }
+  return f;
+}
+static void gcDumpD(FILE* f, const char* tag, const double* v, HighsInt n) {
+  std::fprintf(f, "%s %d", tag, (int)n);
+  for (HighsInt i = 0; i < n; ++i) std::fprintf(f, " %a", v[i]);
+  std::fprintf(f, "\n");
+}
+static void gcDumpI(FILE* f, const char* tag, const HighsInt* v, HighsInt n) {
+  std::fprintf(f, "%s %d", tag, (int)n);
+  for (HighsInt i = 0; i < n; ++i) std::fprintf(f, " %d", (int)v[i]);
+  std::fprintf(f, "\n");
+}
+
 HighsCutGeneration::HighsCutGeneration(const HighsLpRelaxation& lpRelaxation,
                                        HighsCutPool& cutpool)
     : lpRelaxation(lpRelaxation),
@@ -1111,6 +1142,27 @@ bool HighsCutGeneration::generateCut(HighsTransformedLp& transLp,
