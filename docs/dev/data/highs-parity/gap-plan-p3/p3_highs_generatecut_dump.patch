   // apply cut postprocessing including scaling and removal of small
   // coefficients
-  if (!postprocessCut(transLp.getGlobaldom())) return false;
+  if (!postprocessCut(transLp.getGlobaldom())) {
+    if (gcf) std::fprintf(gcf, "GC_PP_FAIL\nGC_END\n");
+    return false;
+  }
   rhs_ = (double)rhs;
   vals_.resize(rowlen);
   inds_.resize(rowlen);
+  if (gcf) {
+    std::fprintf(gcf, "GC_PP_OUT rhs %a isup %d icoef %d\n", rhs_, (int)integralSupport,
+                 (int)integralCoefficients);
+    gcDumpI(gcf, "inds", inds, rowlen);
+    gcDumpD(gcf, "vals", vals, rowlen);
+    std::fprintf(gcf, "GC_END\n");
+  }
 
   lpRelaxation.getMipSolver().mipdata_->debugSolution.checkCut(
       inds_.data(), vals_.data(), rowlen, rhs_);
