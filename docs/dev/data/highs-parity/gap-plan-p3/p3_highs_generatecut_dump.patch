   this->rhs = rhs_;
   complementation.clear();
+  FILE* gcf = gcDumpFile(lpRelaxation.getMipSolver());
+  if (gcf) {
+    std::fprintf(gcf, "GC_IN %ld numcols %d feastol %a epsilon %a onlyinit %d intspos %d rng %llu rhs %a\n",
+                 gcDumpCounter, (int)lpRelaxation.numCols(), feastol, epsilon,
+                 (int)onlyInitialCMIRScale, (int)intsPositive,
+                 (unsigned long long)randgen.debugState(), rhs_);
+    gcDumpI(gcf, "inds", inds, rowlen);
+    gcDumpD(gcf, "vals", vals, rowlen);
+    gcDumpD(gcf, "upper", upper.data(), rowlen);
+    gcDumpD(gcf, "solval", solval.data(), rowlen);
+    std::fprintf(gcf, "isint %d", (int)rowlen);
+    for (HighsInt i = 0; i < rowlen; ++i)
+      std::fprintf(gcf, " %d", (int)lpRelaxation.isColIntegral(inds[i]));
+    std::fprintf(gcf, "\n");
+  }
+  struct GcEnd {
+    FILE* f; long id; const HighsRandom& rg; bool done;
+    GcEnd(FILE* f_, long id_, const HighsRandom& rg_) : f(f_), id(id_), rg(rg_), done(false) {}
+    ~GcEnd() { if (f && !done) std::fprintf(f, "GC_CORE_FAIL %ld rng %llu\nGC_END\n", id, (unsigned long long)rg.debugState()); }
+  } gcend(gcf, gcDumpCounter, randgen);
+  ++gcDumpCounter;
   bool hasUnboundedInts = false;
   bool hasGeneralInts = false;
   bool hasContinuous = false;
@@ -1151,27 +1203,63 @@ bool HighsCutGeneration::generateCut(HighsTransformedLp& transLp,
       vals[i] = vals[rowlen];
     }
   }
+  if (gcf) {
+    gcend.done = true;
+    std::fprintf(gcf, "GC_CORE_OUT %ld rng %llu rhshi %a rhslo %a isup %d icoef %d\n",
+                 gcend.id, (unsigned long long)randgen.debugState(), rhs.debugHi(),
+                 rhs.debugLo(), (int)integralSupport, (int)integralCoefficients);
+    gcDumpI(gcf, "inds", inds, rowlen);
+    gcDumpD(gcf, "vals", vals, rowlen);
+  }
 
   // transform the cut back into the original space, i.e. remove the bound
   // substitution and replace implicit slack variables
   rhs_ = (double)rhs;
   vals_.resize(rowlen);
   inds_.resize(rowlen);
-  if (!transLp.untransform(vals_, inds_, rhs_)) return false;
+  if (!transLp.untransform(vals_, inds_, rhs_)) {
+    if (gcf) std::fprintf(gcf, "GC_UNTRANSFORM_FAIL\nGC_END\n");
+    return false;
+  }
 
   rowlen = inds_.size();
   inds = inds_.data();
   vals = vals_.data();
   rhs = rhs_;
+  if (gcf) {
+    const HighsDomain& gd = transLp.getGlobaldom();
+    std::fprintf(gcf, "GC_PP_IN rhs %a isup %d icoef %d\n", rhs_, (int)integralSupport,
+                 (int)integralCoefficients);
+    gcDumpI(gcf, "inds", inds, rowlen);
+    gcDumpD(gcf, "vals", vals, rowlen);
+    std::fprintf(gcf, "lb %d", (int)rowlen);
+    for (HighsInt i = 0; i < rowlen; ++i) std::fprintf(gcf, " %a", gd.col_lower_[inds[i]]);
+    std::fprintf(gcf, "\nub %d", (int)rowlen);
+    for (HighsInt i = 0; i < rowlen; ++i) std::fprintf(gcf, " %a", gd.col_upper_[inds[i]]);
+    std::fprintf(gcf, "\nisint %d", (int)rowlen);
+    for (HighsInt i = 0; i < rowlen; ++i)
+      std::fprintf(gcf, " %d", (int)lpRelaxation.isColIntegral(inds[i]));
+    std::fprintf(gcf, "\n");
+  }
 
   lpRelaxation.getMipSolver().mipdata_->debugSolution.checkCut(inds, vals,
