+// ---- discopt matched-box dump (HS_DUMP_NODEBOX=<path>): top level only ----
+// One record per node-LP solve ("NBE") and per node separation ("NBS"): the node's
+// full local column box (absolute bounds, %a) and the LP objective / status / row
+// count. Capped at HS_DUMP_NODEBOX_MAX (default 300) records of each kind. Writing
+// only: nothing here feeds back into the solve.
+FILE* hsNodeBoxFile(const HighsMipSolver& mipsolver, bool sep) {
+  static FILE* f = nullptr;
+  static bool init = false;
+  static long maxr = 300;
+  static long ne = 0, ns = 0;
+  if (mipsolver.submip) return nullptr;
+  if (!init) {
+    init = true;
+    if (const char* p = std::getenv("HS_DUMP_NODEBOX")) f = std::fopen(p, "w");
+    if (const char* m = std::getenv("HS_DUMP_NODEBOX_MAX")) maxr = std::atol(m);
+  }
+  if (!f) return nullptr;
+  long& c = sep ? ns : ne;
+  if (c >= maxr) { std::fflush(f); return nullptr; }
+  ++c;
+  return f;
+}
+long hsNodeBoxNextId() { static long id = 0; return id++; }
+void hsNodeBoxWriteBox(FILE* f, const std::vector<double>& lo,
+                       const std::vector<double>& hi) {
+  std::fprintf(f, "L %d", (int)lo.size());
+  for (double v : lo) std::fprintf(f, " %a", v);
+  std::fprintf(f, "\nU %d", (int)hi.size());
+  for (double v : hi) std::fprintf(f, " %a", v);
+  std::fprintf(f, "\n");
+}
