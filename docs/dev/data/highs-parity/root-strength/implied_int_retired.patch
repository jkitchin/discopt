+                        } else {
+                            pick(&mut r)
+                        };
+                        if v != 0.0 {
+                            ri.push(j);
+                            rv.push(v);
+                        }
+                    }
+                }
+                if ri.is_empty() {
+                    continue;
+                }
+                let base = r.int(-4, 4) as f64 + if r.int(0, 5) == 0 { 0.5 } else { 0.0 };
