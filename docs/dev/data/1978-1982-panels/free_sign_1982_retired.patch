+/// #1982 item 1: the NARROWED one-sided product rule (`DISCOPT_FBBT_FREE_SIGN`,
+/// default **off**). `a * b = w` with `w` excluding 0 by more than [`FEAS_TOL`] and
+/// `b` touching 0 from one side forces `b != 0`, so `a` takes `w`'s sign times `b`'s.
+/// Unlike the retired `DISCOPT_FBBT_ONE_SIDED_DIV` (#1616) this only ever replaces
+/// an INFINITE side of a scalar variable `a` (bounds `>= 1e19` are the no-bound
+/// sentinel): a finite bound is never tightened. With `b = [0, g]` and `w >= w_lo`
+/// the free lower side becomes `w_lo / g` (rounded down; `0` when `g` is unbounded).
+pub fn fbbt_free_sign_enabled() -> bool {
+    match std::env::var("DISCOPT_FBBT_FREE_SIGN") {
+        Err(_) => false,
+        Ok(v) => !matches!(
+            v.trim().to_ascii_lowercase().as_str(),
+            "0" | "false" | "off" | "no" | ""
+        ),
+    }
+}
+
+const NO_BOUND: f64 = 1e19;
+
+/// The narrowed rule for target `a` (node `target`) of `a * g in w`; see
+/// [`fbbt_free_sign_enabled`]. Writes `var_bounds` directly: the target is a leaf.
+fn free_sign_mul(
+    arena: &ExprArena,
+    target: ExprId,
+    w: &Interval,
+    g: &Interval,
+    var_bounds: &mut [Interval],
+) {
+    let ExprNode::Variable { index, size: 1, .. } = arena.get(target) else {
+        return;
+    };
+    let a = var_bounds[*index];
+    // `a = w / g`, so sign(a) = sign(w) * sign(g).
+    let w_sign = if w.lo > FEAS_TOL {
+        1.0
+    } else if w.hi < -FEAS_TOL {
+        -1.0
+    } else {
+        return;
+    };
+    let (g_sign, g_mag) = if g.lo == 0.0 && g.hi > 0.0 {
+        (1.0, g.hi)
+    } else if g.hi == 0.0 && g.lo < 0.0 {
+        (-1.0, -g.lo)
+    } else {
+        return;
+    };
+    // |a| >= |w|_min / |g|_max, rounded down; 0 when |g| has no finite bound.
+    let w_min = if w_sign > 0.0 { w.lo } else { -w.hi };
+    let q = if g_mag >= NO_BOUND || !g_mag.is_finite() {
+        0.0
+    } else {
+        div_down(w_min, g_mag).max(0.0)
+    };
+    if w_sign * g_sign > 0.0 {
+        if a.lo <= -NO_BOUND {
+            var_bounds[*index] = a.intersect(&Interval::new(q, f64::INFINITY));
+        }
+    } else if a.hi >= NO_BOUND {
+        var_bounds[*index] = a.intersect(&Interval::new(f64::NEG_INFINITY, -q));
+    }
+}
