+/// #2142: SCIP's weighted candidate score (`cons_nonlinear.c`
+/// `scoreBranchingCandidates`): a pseudocost side is used only once it has
+/// `reliable` observations; both sides reliable give the product score, one side
+/// gives that side alone, none gives no pseudocost component. Each component is
+/// scaled by its maximum over the candidates, and a candidate's weighted sum is
+/// divided by the weights of the components it has. Ties go to the lowest index.
+#[allow(clippy::too_many_arguments)]
+fn scip_normalised_pick(
+    spec: &SpatialKernelSpec,
+    cands: &[usize],
+    viol: &[f64],
+    vmax: f64,
+    x: &[f64],
+    (lo, hi): (&[f64], &[f64]),
+    config: &SpatialTreeConfig,
+    (spc_sum, spc_cnt): (&[Vec<f64>; 2], &[Vec<usize>; 2]),
+    reliable: usize,
+) -> Option<usize> {
+    let w = config.spatial_pscost_weight;
+    const EPS: f64 = 1e-6;
+    let ps: Vec<Option<f64>> = cands
+        .iter()
+        .map(|&c| {
+            if w <= 0.0 {
+                return None;
+            }
+            let p = spatial_split_point(x[c], lo[c], hi[c], global_width(spec, c), config);
+            let side = |d: usize, dist: f64| {
+                (spc_cnt[d][c] >= reliable).then(|| spc_sum[d][c] / spc_cnt[d][c] as f64 * dist)
+            };
+            match (side(0, hi[c] - p), side(1, p - lo[c])) {
+                (Some(d), Some(u)) => Some(d.max(EPS) * u.max(EPS)),
+                (Some(d), None) => Some(d),
+                (None, Some(u)) => Some(u),
+                (None, None) => None,
+            }
+        })
+        .collect();
+    let pmax = ps.iter().flatten().fold(0.0f64, |m, &v| m.max(v));
+    let mut best: Option<(f64, usize)> = None;
+    for (k, &c) in cands.iter().enumerate() {
+        let (mut score, mut wsum) = (viol[c] / vmax, 1.0);
+        if pmax > 0.0 {
+            if let Some(p) = ps[k] {
+                score += w * p / pmax;
+                wsum += w;
+            }
+        }
+        let score = score / wsum;
+        if best.map(|(b, _)| score > b).unwrap_or(true) {
+            best = Some((score, c));
+        }
+    }
+    best.map(|(_, c)| c)
+}
