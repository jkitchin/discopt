+def _spatial_viol_scip_kwargs() -> dict:
+    """#2142: ``DISCOPT_SPATIAL_SCIP_SCORE`` for the native spatial kernel.
+
+    **Default OFF** (branching order only: every child pair still covers its
+    parent box, so no node bound moves). Values:
+
+    - ``1`` / ``full``: SCIP's ``cons_nonlinear`` candidate score. The violation
+      component is a term's McCormick gap divided by ``max(1, |f(x)|)``
+      (``SCIPgetExprRelAuxViolationNonlinear``), split over its operands by midness
+      ``max(0.05, min(x - lo, hi - x) / (hi - lo))`` (``branching/violsplit =
+      'm'``); the pseudocost component uses a side only after 2 observations
+      (``branching/pscostreliable``), and each candidate's weighted sum is divided
+      by the weights it actually used (``scoreBranchingCandidates``).
+    - ``norm``: the pseudocost reliability / normalisation alone, on #1970's
+      absolute, evenly split violation.
+
+    See ``SpatialTreeConfig::spatial_viol_scip`` / ``spatial_pscost_reliable``.
+    Only acts when #1970's ``spatial_score`` is on (the default). Probe: profile
+    counters ``SpatialViolScipPicks`` / ``SpatialViolScipChanged``. Measurements:
+    ``performance-plan.md`` sections 108-109. Read at call time.
+    """
+    raw = os.environ.get("DISCOPT_SPATIAL_SCIP_SCORE", "0").strip().lower()
+    if raw in ("0", "false", "no", "off", ""):
+        return {}
+    if raw in ("1", "full", "true", "on", "yes"):
+        return {"spatial_viol_scip": True, "spatial_pscost_reliable": 2}
+    if raw == "norm":
+        return {"spatial_pscost_reliable": 2}
+    raise ValueError(f"DISCOPT_SPATIAL_SCIP_SCORE={raw!r}: expected 0, 1/full or norm")
+
